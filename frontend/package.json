{
	"name": "frontend",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --incremental",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "pnpm check",
		"lint": "oxfmt --check && eslint .",
		"format": "oxfmt",
		"dup": "jscpd src --threshold 0 --reporters console",
		"verify": "pnpm lint && pnpm typecheck && pnpm dup",
		"build:dev": "vite build --mode development"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/vscode-icons": "^1.2.94",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@types/papaparse": "^5.5.2",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"jscpd": "^5.4.2",
		"oxfmt": "^0.75.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@panzoom/panzoom": "^4.6.2",
		"@viselect/vanilla": "^3.10.1",
		"@wailsio/runtime": "3.0.0",
		"dompurify": "^3.4.17",
		"highlight.js": "^11.12.0",
		"mammoth": "^1.13.0",
		"marked": "^18.1.2",
		"paneforge": "^1.0.2",
		"papaparse": "^5.7.0",
		"svelte-sonner": "^1.2.2"
	},
	"imports": {
		"#/*": "./src/*",
		"#bindings/*": "./bindings/*"
	}
}
