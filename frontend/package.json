{
	"name": "frontend",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "pnpm check",
		"lint": "oxfmt --check && eslint .",
		"format": "oxfmt",
		"dup": "jscpd src --threshold 0 --reporters console",
		"verify": "pnpm lint && pnpm typecheck && pnpm dup",
		"build:dev": "vite build --mode development"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.2.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jscpd": "^5.4.0",
		"oxfmt": "^0.71.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"@wailsio/runtime": "3.0.0-beta.27",
		"mammoth": "^1.13.0"
	},
	"imports": {
		"#/*": "./src/*",
		"#bindings/*": "./bindings/*"
	}
}
