<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Soteria"
        Arguments=""
        InstallLocation="C:\Program Files\ZenSoftware\Soteria">
    </Installer>
    <PackageInformation
        PackageName="Soteria"
        PackageDisplayName="Soteria"
        PublisherName="CN=ZenSoftware"
        PublisherDisplayName="ZenSoftware"
        Version="0.1.0.0"
        PackageDescription="Soteria">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.zenkiet.soteria"
                Description="Soteria"
                DisplayName="Soteria"
                ExecutableName="Soteria"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Soteria</DisplayName>
            <PublisherDisplayName>ZenSoftware</PublisherDisplayName>
            <Description>Soteria</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Soteria.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
